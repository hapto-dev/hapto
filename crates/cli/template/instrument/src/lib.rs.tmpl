//! {{name}}: an instrument, a sine for each note a MIDI keyboard plays.
//!
//! `cargo hapto dev` runs it as an app of its own, which every MIDI input the
//! computer has plays, while you edit it, and `cargo hapto build` lays out its
//! VST3 bundle.

#[cfg(feature = "vst3")]
hapto_host::export_vst3!({{type}});
#[cfg(feature = "cabi")]
hapto_host::export_cabi!({{type}});

use std::f32::consts::TAU;

use hapto_host::layout::StereoOut;
use hapto_host::midi::{Expression, NoteOff, NoteOn, Poly, Voice, VoiceAudio};
use hapto_host::{Block, Parts, Plugin, PluginInfo, ProcessSetup, Processor, Status};
use hapto_params::{Float, Params};

/// How many notes sound at once. A note past them takes a voice from
/// another: a released one first, then the oldest.
const VOICES: usize = 8;
/// How long a released note takes to fall 60 dB, in seconds.
const RELEASE: f32 = 0.3;
/// The level at which a released note stops: 60 dB down.
const SILENT: f32 = 1e-3;

/// The parameters, in the order hosts list them, each declared where it is
/// held. A parameter's key is its identity for good: rename the display name,
/// never the key, once the plugin ships.
#[derive(Debug, Clone, Params)]
pub struct {{type}}Params {
    #[param(
        "level", "Level", -60.0..=0.0, -12.0,
        step = 0.1, unit = "dB",
    )]
    level: Float,
}

/// The plugin, on the main thread.
#[derive(Debug)]
pub struct {{type}} {
    params: {{type}}Params,
}

impl Plugin for {{type}} {
    const INFO: PluginInfo = hapto_host::manifest_info! {
        midi_input: true,
        midi_output: false,
    };

    type Params = {{type}}Params;

    type Processor = {{type}}Processor;

    fn new(params: {{type}}Params, _parts: Parts) -> Self {
        {{type}} { params }
    }

    fn activate(&mut self, setup: &ProcessSetup) -> {{type}}Processor {
        let sample_rate = setup.sample_rate as f32;
        let level = self.params.level.clone();
        {{type}}Processor {
            voices: Poly::new(VOICES, || Sine::new(level.clone(), sample_rate)),
        }
    }
}

/// The audio thread's half: the voices, which `Poly` gives the block's
/// notes.
#[derive(Debug)]
pub struct {{type}}Processor {
    voices: Poly<Sine>,
}

impl Processor for {{type}}Processor {
    // No audio in, two channels out: an instrument's layout.
    type Layout = StereoOut;

    fn process(&mut self, block: Block<'_, StereoOut>) -> Status {
        // Cut at each message, so each note starts on its own frame, and
        // asleep once every voice is silent.
        self.voices.play(block)
    }
}

/// One voice: a sine at its note's pitch, which every bend and tuning a host
/// sends already moves, fading out once nothing holds the note.
#[derive(Debug)]
pub struct Sine {
    level: Float,
    sample_rate: f32,
    /// What a released note's envelope is multiplied by each frame.
    fade: f32,
    phase: f32,
    /// The note's velocity, falling once it is released.
    envelope: f32,
    released: bool,
}

impl Sine {
    fn new(level: Float, sample_rate: f32) -> Self {
        Sine {
            level,
            sample_rate,
            fade: (SILENT.ln() / (RELEASE * sample_rate).max(1.0)).exp(),
            phase: 0.0,
            envelope: 0.0,
            released: true,
        }
    }
}

impl Voice for Sine {
    fn start(&mut self, note: &NoteOn) {
        (self.phase, self.envelope, self.released) = (0.0, note.velocity, false);
    }

    fn release(&mut self, _note: &NoteOff) {
        self.released = true;
    }

    fn render(&mut self, expression: &Expression<'_>, out: &mut VoiceAudio<'_>) {
        let step = expression.pitch.hz() / self.sample_rate;
        // The level for this note: the parameter's, and once a host
        // modulates it for each note, this note's.
        let gain = 10.0_f32.powf(expression.modulated(&self.level) / 20.0);
        for frame in out.frames_mut() {
            // Into both channels, at the note's pan.
            frame.add((self.phase * TAU).sin() * self.envelope * gain);
            self.phase = (self.phase + step).fract();
            if self.released {
                self.envelope *= self.fade;
                // Silent from the frame it is done, wherever the block ends.
                if self.envelope < SILENT {
                    self.envelope = 0.0;
                }
            }
        }
    }

    fn is_done(&self) -> bool {
        self.released && self.envelope == 0.0
    }
}
