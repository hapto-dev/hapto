//! {{name}}: an instrument, a sine for each note a MIDI keyboard plays.
//!
//! `cargo hapto dev` runs it as an app of its own, which every MIDI input the
//! computer has plays, while you edit it, and `cargo hapto build` lays out its
//! VST3 bundle.

#[cfg(feature = "vst3")]
hapto_host::export_vst3!({{type}});
#[cfg(feature = "cabi")]
hapto_host::export_cabi!({{type}});

use std::f32::consts::TAU;

use hapto_host::layout::StereoOut;
use hapto_host::midi::{Message, NoteId};
use hapto_host::{AddSample, Block, Parts, Plugin, PluginInfo, ProcessSetup, Processor, Status};
use hapto_params::{Changes, Float, Params};

/// How many notes sound at once. A note past them takes the quietest.
const VOICES: usize = 8;
/// How long a released note takes to fall 60 dB, in seconds.
const RELEASE: f32 = 0.3;

/// The parameters, in the order hosts list them, each declared where it is
/// held. A parameter's key is its identity for good: rename the display name,
/// never the key, once the plugin ships.
#[derive(Debug, Clone, Params)]
pub struct {{type}}Params {
    #[param(
        "level", "Level", -60.0..=0.0, -12.0,
        step = 0.1, unit = "dB",
    )]
    level: Float,
}

/// The plugin, on the main thread.
#[derive(Debug)]
pub struct {{type}} {
    params: {{type}}Params,
}

impl Plugin for {{type}} {
    const INFO: PluginInfo = hapto_host::manifest_info! {
        midi_input: true,
        midi_output: false,
    };

    type Params = {{type}}Params;

    type Processor = {{type}}Processor;

    fn new(params: {{type}}Params, _parts: Parts) -> Self {
        {{type}} { params }
    }

    fn activate(&mut self, setup: &ProcessSetup) -> {{type}}Processor {
        {{type}}Processor::new(self.params.clone(), setup.sample_rate as f32)
    }
}

/// One sine, and the note it plays.
#[derive(Debug, Clone, Copy, Default)]
struct Voice {
    /// The note it plays; `None` once it has faded out.
    note: Option<NoteId>,
    /// Whether its key is still down.
    held: bool,
    /// How far its phase moves each frame.
    step: f32,
    phase: f32,
    /// Its level: the note's velocity, falling once the key is released.
    level: f32,
}

/// The audio thread's half: a sine for each note, at the level the
/// parameter sets, which it reads again only when it moved.
#[derive(Debug)]
pub struct {{type}}Processor {
    params: {{type}}Params,
    changes: Changes,
    gain: f32,
    sample_rate: f32,
    /// What a released note's level is multiplied by each frame.
    fade: f32,
    voices: [Voice; VOICES],
}

impl {{type}}Processor {
    fn new(params: {{type}}Params, sample_rate: f32) -> Self {
        let mut processor = {{type}}Processor {
            params,
            changes: Changes::new(),
            gain: 0.0,
            sample_rate,
            fade: (1e-3_f32.ln() / (RELEASE * sample_rate).max(1.0)).exp(),
            voices: [Voice::default(); VOICES],
        };
        processor.retune();
        processor
    }

    fn retune(&mut self) {
        let {{type}}Params { level } = &self.params;
        if !self.changes.moved([level]) {
            return;
        }
        self.gain = 10.0_f32.powf(level.get() / 20.0);
    }

    /// Plays `message`, at the start of the span it arrives in. A note ends
    /// by its id, which names it from its note-on to its note-off.
    fn play(&mut self, message: &Message<'_>) {
        match message {
            Message::NoteOn(note) => {
                // A silent voice, else the quietest.
                let voice = self.voices.iter_mut().min_by(|a, b| {
                    (a.note.is_some().cmp(&b.note.is_some())).then(a.level.total_cmp(&b.level))
                });
                if let Some(voice) = voice {
                    *voice = Voice {
                        note: Some(note.id),
                        held: true,
                        step: note.pitch().hz() / self.sample_rate,
                        phase: 0.0,
                        level: note.velocity,
                    };
                }
            }
            Message::NoteOff(note) => {
                for voice in &mut self.voices {
                    if voice.note == Some(note.id) {
                        voice.held = false;
                    }
                }
            }
            _ => {}
        }
    }

    /// The next frame of every voice, summed.
    fn next_sample(&mut self) -> f32 {
        let mut sum = 0.0;
        for voice in self.voices.iter_mut().filter(|voice| voice.note.is_some()) {
            sum += (voice.phase * TAU).sin() * voice.level;
            voice.phase = (voice.phase + voice.step).fract();
            if !voice.held {
                voice.level *= self.fade;
                if voice.level < 1e-3 {
                    voice.note = None;
                }
            }
        }
        sum * self.gain
    }
}

impl Processor for {{type}}Processor {
    // No audio in, two channels out: an instrument's layout.
    type Layout = StereoOut;

    fn process(&mut self, block: Block<'_, StereoOut>) -> Status {
        self.retune();
        // A span starts at each frame a message arrives at, so each note
        // starts on its own frame.
        for mut span in block.spans() {
            for message in span.midi.messages() {
                self.play(&message);
            }
            for frame in span.audio.frames_mut() {
                frame.add(self.next_sample());
            }
        }
        if self.voices.iter().any(|voice| voice.note.is_some()) {
            Status::Continue
        } else {
            Status::Sleep
        }
    }
}
